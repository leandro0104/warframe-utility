{
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/css/(.*)", "destination": "/public/css/$1" },
    { "source": "/js/(.*)", "destination": "/public/js/$1" },
    { "source": "/data/(.*)", "destination": "/public/data/$1" },
    { "source": "/(.*)", "destination": "/index.html" }
  ]
}
